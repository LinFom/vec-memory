                    "ok": {
                      "const": true
                    },
                    "spaceId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ok",
                    "spaceId"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "Failure with a stable code. HTTP status may be 400, 401, 403, 404, 409, 413, 415, 500 or 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "spaceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "projectIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
                    }
                  }
                },
                "required": [
                  "projectIds"
                ],
                "additionalProperties": true
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/spaces/{spaceId}/settings": {
      "get": {
        "summary": "Read non-secret values and secret-presence flags",
        "tags": [
          "Administration"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "values": {
                      "type": "object"
                    },
                    "secrets": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "boolean"
                      }
                    }
                  },
                  "required": [
                    "ok",
                    "values",
                    "secrets"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "Failure with a stable code. HTTP status may be 400, 401, 403, 404, 409, 413, 415, 500 or 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "spaceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
            }
          }
        ]
      },
      "put": {
        "summary": "Patch owned settings; null removes, empty API key preserves",
        "tags": [
          "Administration"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "changed": {
                      "const": true
                    }
                  },
                  "required": [
                    "ok",
                    "changed"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "Failure with a stable code. HTTP status may be 400, 401, 403, 404, 409, 413, 415, 500 or 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "spaceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "patch": {
                    "type": "object",
                    "properties": {
                      "embedBaseURL": {},
                      "embedApiKey": {},
                      "embedModel": {},
                      "embedRevision": {},
                      "embedBatchSize": {},
                      "embedTimeoutMs": {},
                      "embedDimensions": {},
                      "llmBaseURL": {},
                      "llmApiKey": {},
                      "llmModel": {},
                      "llmTimeoutMs": {},
                      "topK": {},
                      "consolidateEnabled": {},
                      "consolidateIntervalMin": {},
                      "autoIndexEnabled": {},
                      "autoIndexIntervalMin": {},
                      "injectEnabled": {},
                      "rememberEnabled": {},
                      "profileCrossScope": {},
                      "llmEndpointKind": {},
                      "consolidateSettleMin": {},
                      "consolidateWindowMsgs": {},
                      "consolidateWindowSpanMin": {},
                      "consolidateMaxWindowsPerRun": {},
                      "consolidateTimeoutMs": {},
                      "promoteHits": {}
                    },
                    "additionalProperties": false
                  }
                },
                "required": [
                  "patch"
                ],
                "additionalProperties": true
              }
            }
          }
        }
      }
    },
    "/api/v1/spaces/{spaceId}/messages": {
      "post": {
        "summary": "Persist source messages; duplicate IDs are idempotent",
        "tags": [
          "Memory"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResult"
                }
              }
            }
          },
          "default": {
            "description": "Failure with a stable code. HTTP status may be 400, 401, 403, 404, 409, 413, 415, 500 or 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "spaceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "messages": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Message"
                    },
                    "maxItems": 500
                  }
                },
                "required": [
                  "messages"
                ],
                "additionalProperties": true
              }
            }
          }
        }
      }
    },
    "/api/v1/spaces/{spaceId}/entities/{entityId}": {
      "put": {
        "summary": "Register entity and display aliases",
        "tags": [
          "Memory"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "entityId": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ok",
                    "entityId"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "Failure with a stable code. HTTP status may be 400, 401, 403, 404, 409, 413, 415, 500 or 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "spaceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
            }
          },
          {
            "name": "entityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "person",
                      "group",
                      "self",
                      "other"
                    ],
                    "default": "person"
                  },
                  "displayName": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "surfaces": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "aliases": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [],
                "additionalProperties": true
              }
            }
          }
        }
      }
    },
    "/api/v1/spaces/{spaceId}/memories": {
      "post": {
        "summary": "Explicit evidence memory or manual declaration",
        "tags": [
          "Memory"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "saved": {
                      "type": "boolean"
                    },
                    "rev": {
                      "type": "integer"
                    },
                    "kind": {
                      "type": "string"
                    },
                    "itemKey": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "speaker": {
                      "type": "string"
                    },
                    "action": {
                      "type": "string"
                    },
                    "replayed": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok",
                    "saved",
                    "rev",
                    "kind"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "Failure with a stable code. HTTP status may be 400, 401, 403, 404, 409, 413, 415, 500 or 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "spaceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "operationId": {
                    "type": "string"
                  },
                  "deliveryId": {
                    "type": "string"
                  },
                  "actorId": {
                    "type": "string"
                  },
                  "userId": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 12000
                  },
                  "scope": {
                    "$ref": "#/components/schemas/Scope"
                  },
                  "kind": {
                    "enum": [
                      "speaker_profile",
                      "trait",
                      "event",
                      "topic",
                      "promise",
                      "joke",
                      "grudge",
                      "preference"
                    ],
                    "default": "preference"
                  },
                  "source": {
                    "enum": [
                      "manual",
                      "assistant",
                      "evidence"
                    ],
                    "default": "assistant"
                  },
                  "evidenceIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "attr": {
                    "type": "string"
                  },
                  "itemKey": {
                    "type": "string"
                  },
                  "aspect": {
                    "type": "string"
                  }
                },
                "required": [
                  "text",
                  "scope"
                ],
                "additionalProperties": true,
                "description": "actorId (or userId) must reference a registered entity. kind defaults to preference; pattern is rejected. source=manual allows no evidence; others require accepted message evidenceIds in the same scope. operationId is recommended for safe retries. trait requires attr or itemKey.",
                "anyOf": [
                  {
                    "required": [
                      "actorId"
                    ]
                  },
                  {
                    "required": [
                      "userId"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
