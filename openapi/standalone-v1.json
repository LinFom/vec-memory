{
  "openapi": "3.1.0",
  "info": {
    "title": "vec-memory standalone protocol",
    "version": "1.0.0",
    "description": "Standalone service. Default port 8091. All business and admin routes require Bearer credentials; admin routes require administrator credentials. POST/PUT bodies must be JSON objects, at most 4 MiB. This contract is separate from the legacy /api/vec service."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8091"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/version": {
      "get": {
        "summary": "Protocol version and implemented capabilities",
        "tags": [
          "Memory"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResult"
                }
              }
            }
          },
          "default": {
            "description": "Failure with a stable code. HTTP status may be 400, 401, 403, 404, 409, 413, 415, 500 or 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/projects": {
      "post": {
        "summary": "Create project; returns projectId and token once",
        "tags": [
          "Administration"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "projectId": {
                      "type": "string"
                    },
                    "token": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ok",
                    "projectId",
                    "token"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "Failure with a stable code. HTTP status may be 400, 401, 403, 404, 409, 413, 415, 500 or 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "projectId": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
                  }
                },
                "required": [
                  "projectId"
                ],
                "additionalProperties": true
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/spaces": {
      "get": {
        "summary": "List spaces, owners, reader projects and project IDs",
        "tags": [
          "Administration"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "spaces": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "owner": {
                            "type": "string"
                          },
                          "readers": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "owner",
                          "readers"
                        ]
                      }
                    },
                    "projects": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "ok",
                    "spaces",
                    "projects"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "Failure with a stable code. HTTP status may be 400, 401, 403, 404, 409, 413, 415, 500 or 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Register a space owner",
        "tags": [
          "Administration"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "spaceId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ok",
                    "spaceId"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "Failure with a stable code. HTTP status may be 400, 401, 403, 404, 409, 413, 415, 500 or 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "spaceId": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
                  },
                  "owner": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
                  }
                },
                "required": [
                  "spaceId",
                  "owner"
                ],
                "additionalProperties": true
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/spaces/{spaceId}/readers": {
      "put": {
        "summary": "Replace the entire reader project list",
