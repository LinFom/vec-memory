    "/api/v1/spaces/{spaceId}/jobs": {
      "post": {
        "summary": "Queue durable background work; operationId supports idempotent retry",
        "tags": [
          "Memory"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResult"
                }
              }
            }
          },
          "default": {
            "description": "Failure with a stable code. HTTP status may be 400, 401, 403, 404, 409, 413, 415, 500 or 503.",
            "content": {
