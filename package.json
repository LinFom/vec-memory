{
  "name": "vec-memory",
  "version": "0.34.0",
  "private": true,
  "type": "module",
  "description": "Local vector knowledge base. Own storage + own HTTP surface; QQ-Agent and other projects attach through PROTOCOL.md.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "spike": "node spike/bench-store.mjs",
    "test": "node --test \"test/*.mjs\"",
    "test:integration": "node test/edges.mjs && node test/graph.mjs && node test/realloop.mjs",
    "serve": "node src/server.mjs",
    "vendor": "node tools/vendor.mjs",
    "serve:standalone": "node tools/standalone-server.mjs serve",
    "init:standalone": "node tools/standalone-server.mjs init",
    "start": "node tools/standalone-server.mjs serve",
    "init": "node tools/standalone-server.mjs init",
    "test:adapter": "node --test adapters/moon/index.test.mjs adapters/qq-agent/protocol-v1.test.mjs"
  },
  "dependencies": {
    "sqlite-vec": "^0.1.9",
    "three": "0.180.0"
  }
}
