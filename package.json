    "serve:standalone": "node tools/standalone-server.mjs serve",
    "test": "node --test \"test/standalone-*.mjs\"",
    "test:adapter": "node --test adapters/qq-agent/protocol-v1.test.mjs"
  },
  "dependencies": {
    "sqlite-vec": "^0.1.9"
  },
  "repository": {
    "type": "git",
