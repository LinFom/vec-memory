{
  "name": "vec-memory",
  "version": "0.30.0",
  "private": true,
  "type": "module",
  "description": "Standalone hybrid memory service: isolated project spaces, evidence-backed memories, keyword/vector recall and adoption.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "init": "node tools/standalone-server.mjs init",
    "start": "node tools/standalone-server.mjs serve",
