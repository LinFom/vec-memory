{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vec-memory portable data protocol template",
  "oneOf": [
    {
      "$ref": "#/$defs/record"
    },
    {
      "$ref": "#/$defs/manifest"
    }
  ],
  "$defs": {
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "id"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "relation"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "relation": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
        }
      }
    },
    "extensionMap": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "key",
        "kind",
        "schemaVersion",
        "revision",
        "operation",
        "recordedAt",
        "payload"
      ],
      "properties": {
        "protocol": {
          "const": "vec-memory/record@1"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "kind": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
        },
        "schemaVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "operation": {
          "enum": [
            "put",
            "delete"
          ]
        },
        "recordedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "payload": {
          "type": "object"
        },
        "extensions": {
          "$ref": "#/$defs/extensionMap"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "delete"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "maxProperties": 0
              }
            }
          }
        }
      ]
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "bytes",
        "records",
        "sha256"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^records/[a-z0-9][a-z0-9_-]{0,79}\\.ndjson$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "records": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "bytes",
        "sha256"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^assets/[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "status"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "omitted"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "partial",
                  "omitted"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "bundleId",
        "createdAt",
        "sourceSpace",
        "profile",
        "datasets",
        "requiredCapabilities",
        "segments",
        "assets"
      ],
      "properties": {
        "protocol": {
          "const": "vec-memory/bundle@1"
        },
        "bundleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "sourceSpace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "profile": {
          "enum": [
            "full",
            "evidence"
          ]
        },
        "datasets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dataset"
          },
          "minItems": 1
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 160,
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
          },
          "uniqueItems": true
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/segment"
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensionMap"
        }
      }
    }
  }
}
